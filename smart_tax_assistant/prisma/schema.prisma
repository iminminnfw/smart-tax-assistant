generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String              @id @default(cuid())
  name                   String?
  firstName              String?             @db.VarChar(120)
  lastName               String?             @db.VarChar(160)
  email                  String              @unique
  password               String
  phone                  String?             @unique @db.VarChar(20)
  dateOfBirth            DateTime?
  address                String?
  district               String?             @db.VarChar(100)
  province               String?             @db.VarChar(100)
  postalCode             String?             @db.VarChar(10)
  occupation             String?             @db.VarChar(120)
  annualIncome           Decimal?            @db.Decimal(12, 2)
  language               Language            @default(TH)
  taxType                TaxType             @default(INDIVIDUAL)
  emailVerified          DateTime?
  image                  String?
  notifyOnPasswordChange NotificationChannel @default(EMAIL)
  notifyEnabled          Boolean             @default(false)
  notifyEmail            Boolean             @default(false)
  notifySms              Boolean             @default(false)
  notifyTaxDeadlines     Boolean             @default(true)
  notifyReports          Boolean             @default(true)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  accounts               Account[]
  deductionRecords       DeductionRecord[]
  files                  DocumentFile[]
  folders                DocumentFolder[]
  incomeRecords          IncomeRecord[]
  sessions               Session[]
  taxFilings             TaxFiling[]
  tokens                 UserToken[]

  // AI Optimizer relations
  financialProfile UserFinancialProfile?
  goals            UserGoal[]
  aiScenarios      AIScenario[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model UserToken {
  id        String        @id @default(cuid())
  userId    String
  type      UserTokenType
  tokenHash String        @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expires])
  @@map("user_tokens")
}

model OTP {
  id          String     @id @default(cuid())
  userId      String?
  email       String
  otpCode     String     @db.VarChar(6)
  purpose     OTPPurpose
  expiresAt   DateTime
  verified    Boolean    @default(false)
  verifiedAt  DateTime?
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([email, purpose])
  @@index([expiresAt])
  @@index([userId])
  @@map("otps")
}

model DocumentFolder {
  id        String           @id @default(cuid())
  name      String           @db.VarChar(200)
  color     String           @default("#3B82F6")
  userId    String
  parentId  String?
  isDeleted Boolean          @default(false)
  deletedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  files     DocumentFile[]
  parent    DocumentFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children  DocumentFolder[] @relation("FolderHierarchy")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([parentId])
  @@index([userId, isDeleted])
  @@map("document_folders")
}

model DocumentFile {
  id               String            @id @default(cuid())
  name             String            @db.VarChar(200)
  content          String?
  fileUrl          String?
  fileName         String?           @db.VarChar(255)
  fileSize         Int?
  mimeType         String?           @db.VarChar(100)
  isUploaded       Boolean           @default(false)
  type             String?
  tags             String[]          @default([])
  isDeleted        Boolean           @default(false)
  deletedAt        DateTime?
  folderId         String?
  userId           String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deductionRecords DeductionRecord[]
  folder           DocumentFolder?   @relation(fields: [folderId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomeRecords    IncomeRecord[]

  @@index([userId])
  @@index([folderId])
  @@index([userId, isDeleted])
  @@map("document_files")
}

model TaxFiling {
  id             String          @id @default(cuid())
  userId         String
  taxYear        Int
  formType       TaxFormType
  status         TaxFilingStatus @default(DRAFT)
  totalIncome    Decimal?        @db.Decimal(12, 2)
  totalDeduction Decimal?        @db.Decimal(12, 2)
  taxAmount      Decimal?        @db.Decimal(12, 2)
  submittedAt    DateTime?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, taxYear])
  @@map("tax_filings")
}

model IncomeRecord {
  id          String        @id @default(cuid())
  userId      String
  type        IncomeType
  amount      Decimal       @db.Decimal(12, 2)
  description String?
  date        DateTime
  taxYear     Int
  documentId  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  document    DocumentFile? @relation(fields: [documentId], references: [id])
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, taxYear])
  @@map("income_records")
}

model DeductionRecord {
  id          String        @id @default(cuid())
  userId      String
  type        DeductionType
  amount      Decimal       @db.Decimal(12, 2)
  description String?
  date        DateTime
  taxYear     Int
  documentId  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  document    DocumentFile? @relation(fields: [documentId], references: [id])
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, taxYear])
  @@map("deduction_records")
}

enum TaxType {
  INDIVIDUAL
}

enum NotificationChannel {
  EMAIL
  SMS
  NONE
}

enum Language {
  TH
  EN
}

enum UserTokenType {
  PASSWORD_RESET
  PASSWORD_CHANGE
  NEW_DEVICE_CONFIRM
  EMAIL_VERIFY
}

enum OTPPurpose {
  EMAIL_VERIFICATION
  LOGIN_MFA
  PASSWORD_RESET
}

enum TaxFilingStatus {
  DRAFT
  SUBMITTED
}

enum TaxFormType {
  PND90
  PND91
  PND94
}

enum IncomeType {
  SALARY
  FREELANCE
  BUSINESS
  INVESTMENT
  RENTAL
  OTHER
}

enum DeductionType {
  PERSONAL
  SPOUSE
  CHILD
  PARENT
  LIFE_INSURANCE
  HEALTH_INSURANCE
  PROVIDENT_FUND
  RMF
  SSF
  DONATION
  HOME_LOAN
  OTHER
}

// ============================================================
// AI Optimizer Models
// ============================================================

// เก็บโปรไฟล์ทางการเงินเพิ่มเติมสำหรับ AI วิเคราะห์
model UserFinancialProfile {
  id     String @id @default(cuid())
  userId String @unique

  // ข้อมูลการเงิน
  monthlyExpenses Decimal? @db.Decimal(12, 2)
  existingSavings Decimal? @db.Decimal(12, 2)
  emergencyFund   Decimal? @db.Decimal(12, 2)

  // ความเสี่ยง
  riskTolerance     RiskTolerance @default(MODERATE)
  investmentHorizon Int? // จำนวนปีที่ต้องการลงทุน

  // สถานะครอบครัว
  maritalStatus MaritalStatus @default(SINGLE)
  numChildren   Int           @default(0)
  numParents    Int           @default(0) // บิดามารดาที่อุปการะ
  hasDisability Boolean       @default(false)

  // สิทธิลดหย่อนที่ใช้ไปแล้ว (ปีปัจจุบัน)
  usedRmf             Decimal? @default(0) @db.Decimal(12, 2)
  usedSsf             Decimal? @default(0) @db.Decimal(12, 2)
  usedThaiEsg         Decimal? @default(0) @db.Decimal(12, 2)
  usedLifeInsurance   Decimal? @default(0) @db.Decimal(12, 2)
  usedHealthInsurance Decimal? @default(0) @db.Decimal(12, 2)
  usedPensionFund     Decimal? @default(0) @db.Decimal(12, 2)
  usedProvidentFund   Decimal? @default(0) @db.Decimal(12, 2)
  usedSocialSecurity  Decimal? @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_financial_profiles")
}

// เก็บเป้าหมายที่ผู้ใช้บอก AI
model UserGoal {
  id     String @id @default(cuid())
  userId String

  // เป้าหมายดิบจากผู้ใช้
  rawGoalText String // "อยากประหยัดภาษี 80,000 บาท"

  // เป้าหมายที่ AI แปลงแล้ว
  goalType     GoalType
  targetAmount Decimal?     @db.Decimal(12, 2)
  deadline     DateTime?
  priority     GoalPriority @default(BALANCED)

  // ข้อจำกัด (เก็บเป็น JSON)
  constraints Json? // [{"type": "minimum_cash", "amount": 1000000}]

  // สถานะ
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarios AIScenario[]

  @@index([userId])
  @@index([userId, isActive])
  @@map("user_goals")
}

// เก็บ scenarios ที่ AI สร้าง
model AIScenario {
  id     String  @id @default(cuid())
  userId String
  goalId String?

  // ข้อมูลพื้นฐาน
  name        String  @db.VarChar(200)
  description String?
  badge       String? @db.VarChar(50) // "🥇 สูงสุด", "⚖️ สมดุล"

  // การจัดสรรการลงทุน
  rmfInvestment     Decimal @default(0) @db.Decimal(12, 2)
  ssfInvestment     Decimal @default(0) @db.Decimal(12, 2)
  thaiEsgInvestment Decimal @default(0) @db.Decimal(12, 2)
  lifeInsurance     Decimal @default(0) @db.Decimal(12, 2)
  pensionFund       Decimal @default(0) @db.Decimal(12, 2)
  totalInvestment   Decimal @default(0) @db.Decimal(12, 2)

  // ผลลัพธ์
  taxSavings    Decimal @default(0) @db.Decimal(12, 2)
  cashRemaining Decimal @default(0) @db.Decimal(12, 2)
  riskLevel     Int     @default(5) // 1-10
  riskLabel     String? @db.VarChar(50) // "ต่ำ", "ปานกลาง", "สูง"

  // AI Analysis
  explanation String? // คำอธิบายจาก AI
  pros        String[] @default([])
  cons        String[] @default([])
  suitableFor String? // "คนที่มีรายได้สูง..."
  actionSteps String[] @default([])

  // กองทุนที่แนะนำ (เก็บเป็น JSON)
  recommendedFunds Json? // [{fundCode, fundName, amount, reason}]

  // Scores
  confidenceScore  Decimal? @db.Decimal(5, 2) // 0-100
  suitabilityScore Decimal? @db.Decimal(5, 2) // 0-100

  // สถานะ
  isSelected Boolean   @default(false) // ผู้ใช้เลือกแผนนี้
  selectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal UserGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, isSelected])
  @@index([goalId])
  @@map("ai_scenarios")
}

// ============================================================
// AI Optimizer Enums
// ============================================================

enum RiskTolerance {
  CONSERVATIVE // ระมัดระวัง
  MODERATE // ปานกลาง
  AGGRESSIVE // กล้าเสี่ยง
}

enum MaritalStatus {
  SINGLE // โสด
  MARRIED // แต่งงาน
  DIVORCED // หย่าร้าง
  WIDOWED // หม้าย
}

enum GoalType {
  TAX_SAVING // ประหยัดภาษี
  CASH_FLOW // เน้นเงินสด
  RETIREMENT // เกษียณ
  LIFE_EVENT // เป้าหมายชีวิต (ซื้อบ้าน, แต่งงาน)
  HYBRID // ผสมผสาน
}

enum GoalPriority {
  AGGRESSIVE // เน้นภาษีสูงสุด
  BALANCED // สมดุล
  CONSERVATIVE // เน้นเงินสด
}

// ============================================================
// SEC Fund Database Models
// ============================================================

// บลจ. (Asset Management Company)
model FundAmc {
  id         String   @id // unique_id from SEC e.g. C0000000021
  nameTh     String // ชื่อ บลจ. ภาษาไทย
  nameEn     String // ชื่อ บลจ. ภาษาอังกฤษ
  lastUpdDate DateTime

  funds Fund[]

  @@map("fund_amcs")
}

// กองทุนหลัก
model Fund {
  id              String   @id // proj_id e.g. M0001_2558
  amcId           String
  regisId         String?
  projNameTh      String // ชื่อกองทุนภาษาไทย
  projNameEn      String // ชื่อกองทุนภาษาอังกฤษ
  projAbbrName    String // ชื่อย่อ (K-EQUITY)
  fundStatus      String // RG/SE/EX/LI/CA
  policyDesc      String? // ประเภท (ตราสารหนี้, ตราสารทุน)
  investmentPolicyDesc  String? // นโยบายการลงทุนละเอียด
  managementStyle       String?
  feederFundMasterFund  String?
  feederFundCountry     String?
  fxHedgingPolicy       String?
  investCountryFlag     Int?    // 0=domestic, 1=foreign
  retailType            String?
  termFlag              String?
  termDay               Int?
  termMonth             Int?
  termYear              Int?
  initDate              DateTime?
  regisDate             DateTime?
  cancelDate            DateTime?
  fundClassName         String?
  fundClassDetail       String?
  fundClassDescription  String?
  taxIncentiveType      String? // SSF/RMF/ThaiESG - สำคัญมากสำหรับ tax optimizer
  isinCode              String?
  lastUpdDate           DateTime

  amc              FundAmc              @relation(fields: [amcId], references: [id])
  riskSpectrums    FundRiskSpectrum[]
  statistics       FundStatistics[]
  performances     FundPerformance[]
  dividendPolicies FundDividendPolicy[]
  topHoldings      FundTopHolding[]
  benchmarks       FundBenchmark[]
  specs            FundSpec[]
  factsheetUrls    FundFactsheetUrl[]

  @@index([fundStatus])
  @@index([amcId])
  @@index([taxIncentiveType])
  @@index([policyDesc])
  @@map("funds")
}

// ระดับความเสี่ยง
model FundRiskSpectrum {
  id              String   @id @default(cuid())
  fundId          String
  startDate       DateTime
  endDate         DateTime
  prospectusType  String
  riskSpectrum    Int // 1-8 (stripped from RS1-RS8)
  riskSpectrumDesc String?
  lastUpdDate     DateTime

  fund Fund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([fundId])
  @@index([fundId, endDate])
  @@index([riskSpectrum])
  @@map("fund_risk_spectrums")
}

// สถิติกองทุน
model FundStatistics {
  id              String   @id @default(cuid())
  fundId          String
  fundClassName   String?
  startDate       DateTime
  endDate         DateTime
  prospectusType  String
  turnoverRatio         Float?
  recoveringPeriod      Float?
  portfolioDurationPeriod Float?
  maxDrawdown           Float?
  sharpeRatio           Float?
  beta                  Float?
  alpha                 Float?
  fxHedging             Float?
  trackingError         Float?
  yieldToMaturity       Float?
  lastUpdDate           DateTime

  fund Fund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([fundId])
  @@index([fundId, endDate])
  @@index([sharpeRatio])
  @@map("fund_statistics")
}

// ผลตอบแทน
model FundPerformance {
  id              String   @id @default(cuid())
  fundId          String
  fundClassName   String?
  startDate       DateTime
  endDate         DateTime
  prospectusType  String
  performanceTypeDesc  String
  referencePeriod      String
  performanceValue     Float?
  lastUpdDate          DateTime

  fund Fund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([fundId])
  @@index([fundId, endDate, referencePeriod])
  @@map("fund_performances")
}

// นโยบายปันผล
model FundDividendPolicy {
  id              String   @id @default(cuid())
  fundId          String
  fundClassName   String?
  startDate       DateTime
  endDate         DateTime
  prospectusType  String
  dividendPolicy  String // Y/N
  lastUpdDate     DateTime

  fund Fund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([fundId])
  @@index([fundId, endDate])
  @@map("fund_dividend_policies")
}

// สินทรัพย์ที่ถือ Top 5
model FundTopHolding {
  id              String   @id @default(cuid())
  fundId          String
  startDate       DateTime
  endDate         DateTime
  prospectusType  String
  assetSeq        Int // ลำดับ (1-5)
  assetName       String
  assetRatio      Float?
  lastUpdDate     DateTime

  fund Fund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([fundId])
  @@index([fundId, endDate])
  @@map("fund_top_holdings")
}

// ดัชนีอ้างอิง
model FundBenchmark {
  id              String   @id @default(cuid())
  fundId          String
  startDate       DateTime
  endDate         DateTime
  prospectusType  String
  groupSeq        Int
  benchmark       String
  benchmarkRemark String?
  lastUpdDate     DateTime

  fund Fund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([fundId])
  @@index([fundId, endDate])
  @@map("fund_benchmarks")
}

// คุณสมบัติกองทุน
model FundSpec {
  id              String   @id @default(cuid())
  fundId          String
  fundClassName   String?
  specCode        String // CIV, RMF, TESG, etc.
  specDesc        String?
  lastUpdDate     DateTime

  fund Fund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([fundId])
  @@index([specCode])
  @@map("fund_specs")
}

// ลิงก์ Factsheet
model FundFactsheetUrl {
  id              String    @id @default(cuid())
  fundId          String
  fundClassName   String?
  prospectusType  String?
  amcUrlFactsheet String?
  pdfFactsheet    String?
  asOfDate        DateTime?
  lastUpdDate     DateTime

  fund Fund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([fundId])
  @@map("fund_factsheet_urls")
}
